{
  "name": "aipodbuilder-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "astro dev --host localhost --port 4321",
    "build": "node scripts/generate-store.mjs && npm run lint:content -- --source-only && node scripts/build-og.mjs && astro build && node scripts/build-page-assets.mjs && npm run lint:content && npm run scan:secrets",
    "dev:full": "npm run build && node scripts/dev-worker.mjs --stripe",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "node scripts/format-safe.mjs",
    "lint:content": "node scripts/lint-content.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "test": "vitest run && npm run test:worker && npm run lint:content && npm run scan:secrets",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:builds && npm run test:deployment && npm run test:e2e && npm run test:worker:discovery && npm run test:security && npm run test:perf && npm run audit:dependencies",
    "test:builds": "node scripts/test-builds.mjs",
    "test:worker:discovery": "node scripts/test-worker-discovery.mjs",
    "dev:worker": "node scripts/dev-worker.mjs",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "check:dev-vars": "node scripts/check-dev-vars.mjs",
    "stripe:sync:apply": "node scripts/stripe/sync-products.mjs --apply",
    "zip:sample": "node scripts/make-sample-zip.mjs",
    "stripe:sync:live": "node scripts/stripe/sync-products.mjs --live",
    "dev:stripe": "node scripts/stripe/listen.mjs",
    "db:migrate:local": "node scripts/migrate-local.mjs",
    "stripe:sync": "node scripts/stripe/sync-products.mjs",
    "stripe:check": "node scripts/stripe/check-cli.mjs --account",
    "stripe:webhook-secret": "node scripts/stripe/dev-webhook-secret.mjs",
    "build:worker": "node scripts/build-worker.mjs",
    "test:security": "npm run build:worker && node scripts/scan-secrets.mjs --artifacts",
    "test:perf": "node scripts/test-performance.mjs",
    "audit:dependencies": "npm audit --audit-level=low",
    "build:preview": "node scripts/build-environment.mjs preview",
    "build:production": "node scripts/build-environment.mjs production",
    "check:deployment": "node scripts/check-deployment.mjs",
    "scan:release": "node scripts/scan-secrets.mjs --artifacts --release",
    "test:deployment": "node scripts/test-deployment-builds.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/inter": "^5.2.0",
    "@fontsource/jetbrains-mono": "^5.2.0",
    "@fontsource/pixelify-sans": "^5.2.0",
    "astro": "^7.4.1",
    "fflate": "^0.8.3",
    "stripe": "^23.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@axe-core/playwright": "^4.11.0",
    "@cloudflare/vitest-plugin": "^1.4.5",
    "@cloudflare/workers-types": "5.20261019.1",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.58.0",
    "@stripe/cli": "^1.54.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.0",
    "eslint-plugin-astro": "^3.2.1",
    "lighthouse": "^13.5.0",
    "prettier": "^3.0.0",
    "prettier-plugin-astro": "^1.1.1",
    "puppeteer-core": "^25.15.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.12",
    "web-vitals": "^6.2.3",
    "wrangler": "^4.151.2",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "@stripe/cli@1.54.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
