{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "worker/**/*.ts",
    "tests/**/*.ts",
    "*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    ".local-tools",
    ".npm-cache",
    ".wrangler",
    "output",
    "test-results",
    "playwright-report"
  ],
  "compilerOptions": {
    "types": ["node"],
    "resolveJsonModule": true
  }
}
