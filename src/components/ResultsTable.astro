---
interface Props {
  caption: string;
  columns: string[];
  rows: string[][];
}
const { caption, columns, rows } = Astro.props;
---

<div class="table-scroll" tabindex="0" role="region" aria-label={caption}>
  <table>
    <caption>{caption}</caption>
    <thead>
      <tr>
        {columns.map((column) => (
          <th scope="col">{column}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          {row.map((cell, i) =>
            i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>,
          )}
        </tr>
      ))}
    </tbody>
  </table>
</div>
