---
interface Props {
  text: string;
  title: string;
  language?: string;
}
const { text, title, language = 'text' } = Astro.props;
---

<div class="copy-block" data-copy-block>
  <div class="copy-toolbar">
    <span>{language}</span>
    <div>
      <button
        type="button"
        data-wrap
        aria-pressed="false"
        aria-label={`Wrap prompt: ${title}`}
      >
        Wrap
      </button>
      <button type="button" data-copy aria-label={`Copy prompt: ${title}`}>
        Copy <span aria-hidden="true">▣</span>
      </button>
    </div>
  </div>
  <pre
    tabindex="0"
    aria-label={title}
  ><code class={`language-${language}`}>{text}</code></pre>
  <p
    class="copy-status"
    role="status"
    aria-live="polite"
    aria-atomic="true"
  ></p>
</div>
<script>
  document
    .querySelectorAll<HTMLElement>('[data-copy-block]')
    .forEach((block) => {
      const pre = block.querySelector('pre');
      const source = block.querySelector('code');
      const status = block.querySelector('[role="status"]');
      block
        .querySelector<HTMLButtonElement>('[data-copy]')
        ?.addEventListener('click', async () => {
          if (!source || !status) return;
          try {
            await navigator.clipboard.writeText(source.textContent ?? '');
            status.textContent = 'Copied!';
          } catch {
            status.textContent =
              'Copy is unavailable. Select the prompt text and copy it yourself.';
          }
        });
      const wrap = block.querySelector<HTMLButtonElement>('[data-wrap]');
      wrap?.addEventListener('click', () => {
        const wrapped = wrap.getAttribute('aria-pressed') !== 'true';
        wrap.setAttribute('aria-pressed', String(wrapped));
        pre?.classList.toggle('wrapped', wrapped);
      });
    });
</script>
<style>
  .copy-block {
    border: 1px solid var(--grey);
    background: var(--panel);
    color: var(--cream);
    border-radius: 12px;
    overflow: hidden;
    --focus: var(--teal);
  }
  .copy-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 16px;
    border-bottom: 1px solid var(--grey);
    font: 14px var(--font-code);
    color: var(--grey);
  }
  .copy-toolbar > div {
    display: flex;
    gap: 8px;
  }
  button {
    min-width: 64px;
    min-height: 44px;
    border: 1px solid var(--grey);
    border-radius: 4px;
    background: transparent;
    color: var(--cream);
    font-size: 14px;
  }
  button[aria-pressed='true'] {
    color: var(--ink);
    background: var(--teal);
  }
  pre {
    margin: 0;
    padding: 24px;
    overflow: auto;
    white-space: pre;
  }
  pre.wrapped {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .copy-status {
    padding: 0 24px 12px;
    min-height: 34px;
    font-size: 14px;
    color: var(--teal);
    margin: 0;
  }
</style>
