---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="faq">
    <h2>Good questions</h2>
    {items.map((item) => (
      <details>
        <summary>{item.q}</summary>
        <p>{item.a}</p>
      </details>
    ))}
  </section>
)}
<style>
  .faq {
    margin-block: 48px;
  }
  details {
    border-bottom: 1px solid var(--border);
    padding-block: 8px;
  }
  summary {
    cursor: pointer;
    min-height: 44px;
    padding: 8px 0;
    font-weight: 600;
  }
  details p {
    padding: 12px 0;
  }
</style>
