---
interface Props {
  variant?: 'note' | 'tip' | 'warning' | 'BROKE' | 'FIXED';
  title?: string;
}
const { variant = 'note', title = variant } = Astro.props;
---

<aside class:list={['callout', variant.toLowerCase()]}>
  <strong>{title}</strong>
  <div>
    <slot />
  </div>
</aside>
<style>
  .callout {
    border: 1px solid var(--border);
    border-left: 4px solid var(--link);
    padding: 24px;
    border-radius: 4px;
    margin-block: 24px;
  }
  strong {
    display: inline-block;
    font: 600 18px var(--font-display);
    background: var(--teal);
    color: var(--ink);
    padding: 4px 8px;
    margin-bottom: 12px;
  }
  .warning strong,
  .broke strong {
    background: var(--magenta);
  }
  .fixed strong {
    background: var(--lime);
  }
  .callout :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
