---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}
const { headings } = Astro.props;
---

{headings.length > 0 && (
  <nav class="toc" aria-label="On this page">
    <details open>
      <summary>On this page</summary>
      <ul>
        {headings
          .filter((h) => h.depth <= 3)
          .map((h) => (
            <li>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
      </ul>
    </details>
  </nav>
)}
<style>
  .toc {
    position: sticky;
    top: 24px;
    align-self: start;
  }
  .toc details {
    border: 1px solid var(--border);
    padding: 16px;
    border-radius: 12px;
  }
  .toc summary {
    font-weight: 600;
    min-height: 44px;
    cursor: pointer;
  }
  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .toc a {
    display: block;
    font-size: 14px;
    padding: 10px 0;
    min-height: 44px;
  }
  @media (max-width: 959px) {
    .toc {
      position: static;
      order: -1;
    }
  }
</style>
