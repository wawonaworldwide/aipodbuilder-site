{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aipodbuilder-local",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aipb-orders-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "DOWNLOADS",
      "bucket_name": "aipb-downloads",
    },
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
  "vars": {
    "PUBLIC_SITE_URL": "http://localhost:8787",
    "STORE_MODE": "test",
    "EMAIL_PROVIDER": "log",
    "LOCAL_DEV": "true",
    "TURNSTILE_MODE": "verify",
    "KIT_UPDATES_FORM_ID": "",
    "MAIL_PROVIDER": "log",
    "MAIL_FROM": "AI POD Builder <hello@aipodbuilder.com>",
    "SUPPORT_EMAIL": "hello@aipodbuilder.com",
    "DOWNLOAD_TTL_HOURS": "72",
    "DOWNLOAD_MAX_USES": "5",
    "SHOW_DRAFTS": "true",
    "STRIPE_API_VERSION": "2025-03-31.basil",
    "PUBLIC_TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "KIT_TAG_WEEKLY_NICHES": "",
    "KIT_TAG_APP_UPDATES": "",
    "KIT_TAG_LAUNCH_COUPONS": "",
    "PRICE_DISPLAY_SUFFIX": " + tax",
    "PUBLIC_CF_ANALYTICS_TOKEN": "",
    "DEPLOY_ENV": "local",
  },
  "env": {
    "preview": {
      "name": "aipodbuilder-preview",
      "workers_dev": true,
      "preview_urls": false,
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": true,
        "not_found_handling": "404-page",
      },
      "build": {
        "command": "npm run check:deployment -- preview && npm run build:preview",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "aipb-orders-preview",
          "database_id": "56e1fec3-e033-4aa6-a427-eee03f45c29b",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "DOWNLOADS",
          "bucket_name": "aipb-downloads-preview",
        },
      ],
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 10,
            "period": 60,
          },
        },
      ],
      "triggers": {
        "crons": [],
      },
      "observability": {
        "enabled": false,
      },
      "vars": {
        "PUBLIC_SITE_URL": "https://aipodbuilder-preview.wawonaworldwide.workers.dev",
        "STORE_MODE": "off",
        "EMAIL_PROVIDER": "kit",
        "LOCAL_DEV": "false",
        "TURNSTILE_MODE": "verify",
        "KIT_UPDATES_FORM_ID": "",
        "MAIL_PROVIDER": "resend",
        "MAIL_FROM": "AI POD Builder <hello@aipodbuilder.com>",
        "SUPPORT_EMAIL": "hello@aipodbuilder.com",
        "DOWNLOAD_TTL_HOURS": "72",
        "DOWNLOAD_MAX_USES": "5",
        "SHOW_DRAFTS": "true",
        "STRIPE_API_VERSION": "2025-03-31.basil",
        "PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFeayCeA-X8tDn_i",
        "KIT_TAG_WEEKLY_NICHES": "24868906",
        "KIT_TAG_APP_UPDATES": "24868911",
        "KIT_TAG_LAUNCH_COUPONS": "24868915",
        "PRICE_DISPLAY_SUFFIX": " + tax",
        "PUBLIC_CF_ANALYTICS_TOKEN": "",
        "DEPLOY_ENV": "preview",
        "PUBLIC_INDEXABLE": "false",
        "KIT_OWNER_TAGS": "{}",
        "KIT_SIGNUP_FORM_ID": "10077333",
      },
      "secrets": {
        "required": ["TURNSTILE_SECRET_KEY", "KIT_API_KEY"],
      },
    },
    "production": {
      "name": "aipodbuilder-production",
      "workers_dev": false,
      "preview_urls": false,
      "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "run_worker_first": true,
        "not_found_handling": "404-page",
      },
      "build": {
        "command": "npm run check:deployment -- production && npm run build:production",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "aipb-orders-production",
          "database_id": "6a8c61f6-bae1-40f5-a7d4-684536c1bcd1",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [],
      "ratelimits": [
        {
          "name": "RATE_LIMITER",
          "namespace_id": "1003",
          "simple": {
            "limit": 10,
            "period": 60,
          },
        },
      ],
      "triggers": {
        "crons": [],
      },
      "observability": {
        "enabled": false,
      },
      "vars": {
        "PUBLIC_SITE_URL": "https://aipodbuilder.com",
        "STORE_MODE": "off",
        "EMAIL_PROVIDER": "kit",
        "LOCAL_DEV": "false",
        "TURNSTILE_MODE": "verify",
        "KIT_UPDATES_FORM_ID": "",
        "MAIL_PROVIDER": "log",
        "MAIL_FROM": "TEE-BOT <tee-bot@aipodbuilder.com>",
        "SUPPORT_EMAIL": "tee-bot@aipodbuilder.com",
        "DOWNLOAD_TTL_HOURS": "72",
        "DOWNLOAD_MAX_USES": "5",
        "SHOW_DRAFTS": "false",
        "STRIPE_API_VERSION": "2025-03-31.basil",
        "PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFfXYOwOaiLPOuea",
        "KIT_TAG_WEEKLY_NICHES": "24868906",
        "KIT_TAG_APP_UPDATES": "24868911",
        "KIT_TAG_LAUNCH_COUPONS": "24868915",
        "PRICE_DISPLAY_SUFFIX": " + tax",
        "PUBLIC_CF_ANALYTICS_TOKEN": "",
        "DEPLOY_ENV": "production",
        "PUBLIC_INDEXABLE": "true",
        "KIT_OWNER_TAGS": "{}",
        "KIT_SIGNUP_FORM_ID": "10077333",
      },
      "routes": [
        {
          "pattern": "aipodbuilder.com",
          "custom_domain": true,
        },
        {
          "pattern": "www.aipodbuilder.com",
          "custom_domain": true,
        },
      ],
      "secrets": {
        "required": ["TURNSTILE_SECRET_KEY", "KIT_API_KEY"],
      },
      "limits": {
        "cpu_ms": 50,
      },
    },
  },
}
